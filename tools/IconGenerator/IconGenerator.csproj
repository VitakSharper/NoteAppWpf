<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes src/NoteApp/Resources/app.ico from Logo.cs (how to run it: Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF draws the logo (DrawingVisual, RenderTargetBitmap); no window is ever shown. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
