<Window x:Class="NoteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:NoteApp.ViewModels"
        xmlns:views="clr-namespace:NoteApp.Views"
        mc:Ignorable="d"
        Title="NoteApp" Height="700" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NoteListViewModel}">
            <views:NoteListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NoteEditorViewModel}">
            <views:NoteEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagManagerViewModel}">
            <views:TagManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsDrawerOpen}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <DockPanel MinWidth="220">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="16,16,16,8">
                        <Viewbox Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,1 L15,1 L21,7 L21,23 L3,23 Z" Fill="#3F51B5"/>
                                <Path Data="M15,1 L15,7 L21,7 Z" Fill="#3F51B5" Opacity="0.45"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="10" Width="11" Height="1.4"
                                           Fill="White" Opacity="0.6" RadiusX="0.7" RadiusY="0.7"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="13.5" Width="8" Height="1.4"
                                           Fill="White" Opacity="0.6" RadiusX="0.7" RadiusY="0.7"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="17" Width="10" Height="1.4"
                                           Fill="White" Opacity="0.6" RadiusX="0.7" RadiusY="0.7"/>
                                <Path Data="M19.5,15 L22.5,12 L23.5,13 L20.5,16 Z" Fill="#FFC107"/>
                                <Path Data="M19.5,15 L19,16.8 L20.5,16 Z" Fill="#FF9800"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="NoteApp"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Separator DockPanel.Dock="Top" />
                    <StackPanel Margin="0,8">
                        <Button Content="Notes"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,12" Height="Auto"
                                Command="{Binding NavigateToNotesCommand}"
                                materialDesign:ButtonAssist.CornerRadius="0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="NoteMultiple" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="Notes" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Tags"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,12" Height="Auto"
                                Command="{Binding NavigateToTagsCommand}"
                                materialDesign:ButtonAssist.CornerRadius="0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TagMultiple" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="Tags" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Settings"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,12" Height="Auto"
                                Command="{Binding NavigateToSettingsCommand}"
                                materialDesign:ButtonAssist.CornerRadius="0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CogOutline" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <DockPanel>
                <!-- Top App Bar -->
                <materialDesign:ColorZone Mode="PrimaryMid" DockPanel.Dock="Top"
                                          Padding="16,8" materialDesign:ElevationAssist.Elevation="Dp4">
                    <DockPanel>
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                                CommandParameter="{x:Static Dock.Left}"
                                DockPanel.Dock="Left">
                            <materialDesign:PackIcon Kind="Menu" />
                        </Button>
                        <!-- App Logo -->
                        <Viewbox Width="30" Height="30" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Canvas Width="24" Height="24">
                                <!-- Note paper -->
                                <Path Data="M3,1 L15,1 L21,7 L21,23 L3,23 Z" Fill="White"/>
                                <!-- Fold -->
                                <Path Data="M15,1 L15,7 L21,7 Z" Fill="White" Opacity="0.45"/>
                                <!-- Text lines -->
                                <Rectangle Canvas.Left="6" Canvas.Top="10" Width="11" Height="1.4"
                                           Fill="#3F51B5" Opacity="0.35" RadiusX="0.7" RadiusY="0.7"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="13.5" Width="8" Height="1.4"
                                           Fill="#3F51B5" Opacity="0.35" RadiusX="0.7" RadiusY="0.7"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="17" Width="10" Height="1.4"
                                           Fill="#3F51B5" Opacity="0.35" RadiusX="0.7" RadiusY="0.7"/>
                                <!-- Pencil -->
                                <Path Data="M19.5,15 L22.5,12 L23.5,13 L20.5,16 Z" Fill="#FFC107"/>
                                <Path Data="M19.5,15 L19,16.8 L20.5,16 Z" Fill="#FF9800"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="NoteApp" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{Binding CreateNoteCommand}"
                                DockPanel.Dock="Right" ToolTip="New Note">
                            <materialDesign:PackIcon Kind="Plus" />
                        </Button>
                        <TextBlock /> <!-- spacer -->
                    </DockPanel>
                </materialDesign:ColorZone>

                <!-- Snackbar -->
                <materialDesign:Snackbar DockPanel.Dock="Bottom"
                                         MessageQueue="{Binding MessageQueue}" />

                <!-- Content -->
                <ContentControl Content="{Binding CurrentView}" Margin="0" />
            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
