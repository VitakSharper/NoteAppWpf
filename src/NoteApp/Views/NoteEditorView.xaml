<UserControl x:Class="NoteApp.Views.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:NoteApp.Converters"
             xmlns:vm="clr-namespace:NoteApp.ViewModels"
             xmlns:views="clr-namespace:NoteApp.Views"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:FileSizeConverter x:Key="FileSize" />

        <!-- Formatting toolbar: flat tool buttons on the card surface, separated by hairlines,
             instead of the stock WPF ToolBar band. -->
        <Style x:Key="FormatToolButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        </Style>
        <Style x:Key="FormatToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource MaterialDesignDivider}" />
        </Style>

        <!-- Text Block Template -->
        <DataTemplate x:Key="TextBlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,4" Padding="0,0,0,6"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Bold" Click="OnBold" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="FormatBold" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Italic" Click="OnItalic" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="FormatItalic" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Underline" Click="OnUnderline" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="FormatUnderline" Width="20" Height="20" />
                        </Button>
                        <Rectangle Style="{StaticResource FormatToolSeparator}" />
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Bullet List" Click="OnBulletList" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Insert Image" Click="OnInsertImage" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="ImageOutline" Width="20" Height="20" />
                        </Button>
                        <Rectangle Style="{StaticResource FormatToolSeparator}" />
                        <Button Style="{StaticResource FormatToolButton}" ToolTip="Search text (Ctrl+F)" Click="OnToggleSearch" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Search Bar (initially collapsed) -->
                <Border Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="8,6" Margin="0,4,0,6"
                        Tag="{Binding}" Loaded="OnSearchBarLoaded">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" ToolTip="Close Search" Click="OnCloseSearch"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Margin="4,0,0,0" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                        <Button DockPanel.Dock="Right" ToolTip="Next Match" Click="OnSearchNext"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" />
                        </Button>
                        <Button DockPanel.Dock="Right" ToolTip="Previous Match" Click="OnSearchPrevious"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Tag="{Binding}">
                            <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16" />
                        </Button>
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="8,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12" Tag="{Binding}" Loaded="OnSearchStatusLoaded" />
                        <TextBox materialDesign:HintAssist.Hint="Search in text…"
                                 FontSize="13" Padding="4,2"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                 BorderThickness="0"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown"
                                 Tag="{Binding}" Loaded="OnSearchTextBoxLoaded" />
                    </DockPanel>
                </Border>

                <!-- The box grows with its content; only the pane scrolls (one scrollbar).
                     PreviewMouseWheel hands the wheel to the pane, see code-behind. -->
                <RichTextBox Grid.Row="2"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Disabled"
                             MinHeight="140" Padding="4,8"
                             BorderThickness="0" Background="Transparent"
                             Tag="{Binding}"
                             Loaded="OnRichTextBoxLoaded"
                             Unloaded="OnRichTextBoxUnloaded"
                             LostFocus="OnRichTextLostFocus"
                             TextChanged="OnRichTextChanged"
                             PreviewMouseWheel="OnRichTextBoxPreviewMouseWheel" />
            </Grid>
        </DataTemplate>

        <!-- File Block Template -->
        <DataTemplate x:Key="FileBlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <StackPanel Orientation="Horizontal" Margin="4">
                <materialDesign:PackIcon Kind="FileOutline" Width="24" Height="24"
                                         VerticalAlignment="Center" Margin="0,0,12,0"
                                         Foreground="{StaticResource AccentBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontWeight="Medium" />
                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSize}}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                </StackPanel>
                <Button Content="Change" Margin="16,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding DataContext.BrowseFileForBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Margin="4,0,0,0" ToolTip="Save file to disk"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding DataContext.SaveFileToDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Link Block Template -->
        <DataTemplate x:Key="LinkBlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <StackPanel>
                <TextBox Text="{Binding LinkUrlText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="https://example.com"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,8" />
                <TextBox Text="{Binding LinkDescription, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Description (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="60" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </DataTemplate>

        <views:BlockTemplateSelector x:Key="BlockSelector"
                                     TextBlockTemplate="{StaticResource TextBlockTemplate}"
                                     FileBlockTemplate="{StaticResource FileBlockTemplate}"
                                     LinkBlockTemplate="{StaticResource LinkBlockTemplate}" />
    </UserControl.Resources>

    <!-- The pane itself is Paper (set in MainWindow) so the block cards stand out. -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" ToolTip="Close editor (Esc)"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding CancelCommand}"
                    Width="36" Height="36">
                <materialDesign:PackIcon Kind="Close" Width="22" Height="22" />
            </Button>
            <Button DockPanel.Dock="Right" ToolTip="Export text blocks to PDF"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Click="OnExportToPdf"
                    Width="36" Height="36" Margin="0,0,4,0">
                <materialDesign:PackIcon Kind="FilePdfBox" Width="22" Height="22" />
            </Button>
            <Button DockPanel.Dock="Right" ToolTip="Export to Word (.docx): text, links and attachment names"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Click="OnExportToWord"
                    Width="36" Height="36" Margin="0,0,4,0">
                <materialDesign:PackIcon Kind="FileWordBox" Width="22" Height="22" />
            </Button>
            <!-- Deletion belongs to the shell (it goes through the list's UNDO), hence the Window binding -->
            <Button DockPanel.Dock="Right" ToolTip="Move this note to the trash"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding DataContext.DeleteOpenNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Width="36" Height="36" Margin="0,0,4,0">
                <materialDesign:PackIcon Kind="TrashCanOutline" Width="22" Height="22" />
            </Button>
            <TextBlock Text="{Binding EditorTitle}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Title -->
        <TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Note title"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource ControlCornerRadius}"
                 FontSize="16" Margin="0,0,0,12" />

        <!-- Add Block -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Add a block" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                </StackPanel.Resources>
                <Button Command="{Binding AddTextBlockCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="NoteText" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Text" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddFileBlockCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="File" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddLinkBlockCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Link" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Link" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Blocks List -->
        <ScrollViewer Grid.Row="3" x:Name="BlocksScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                        <!-- Outlined card; the outline turns accent while the block has keyboard focus -->
                        <Border Margin="0,0,0,12" Padding="12"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Block Header: kind icon + label, actions on the right -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Width" Value="28" />
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Button ToolTip="Move Up"
                                                Command="{Binding DataContext.MoveBlockUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" />
                                        </Button>
                                        <Button ToolTip="Move Down"
                                                Command="{Binding DataContext.MoveBlockDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16" />
                                        </Button>
                                        <Button ToolTip="Remove block"
                                                Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Foreground="{StaticResource AccentBrush}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="NoteText" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BlockType}" Value="File">
                                                            <Setter Property="Kind" Value="FileDocument" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BlockType}" Value="Link">
                                                            <Setter Property="Kind" Value="Link" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding BlockLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Block Content (selected by template) -->
                                <ContentControl Grid.Row="1" Content="{Binding}"
                                                ContentTemplateSelector="{StaticResource BlockSelector}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Blocks.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="NotePlus" Width="48" Height="48" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="Add content blocks using the buttons above"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,8"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <!-- Tags & Encryption (collapsible) -->
        <Expander Grid.Row="4" Margin="0,8,0,8" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Tags &amp; Settings" VerticalAlignment="Center"
                               FontSize="14" FontWeight="Medium" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
                <!-- Tags -->
                <GroupBox Header="Tags" Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignGroupBox}">
                    <StackPanel>
                        <!-- Inline tag creation -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding CreateTagInlineCommand}"
                                    Content="Add Tag" Padding="12,6" />
                            <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Type a new tag name..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </DockPanel>

                        <!-- Existing tags as toggleable chips -->
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Name.Value}" Margin="4"
                                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                                  Padding="12,6" FontSize="12"
                                                  MinWidth="0" Width="Auto" Height="Auto"
                                                  Checked="OnTagChecked" Unchecked="OnTagUnchecked"
                                                  Tag="{Binding}"
                                                  Loaded="OnTagToggleLoaded" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="No tags yet — type a name above and click 'Add Tag' to create one."
                                   FontSize="12" FontStyle="Italic" Margin="4,4,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailableTags.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Encryption -->
                <Border Padding="12" CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Lock" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Foreground="{StaticResource AccentBrush}" />
                        <CheckBox Content="Encrypt with password"
                                  IsChecked="{Binding IsEncrypted}"
                                  VerticalAlignment="Center" FontSize="13" />
                        <TextBlock Text="(content will be encrypted in the database)"
                                   FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Expander>

        <!-- Error + Actions -->
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        ToolTip="Close editor (Esc)" />
                <Button Content="Save" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save (Ctrl+S)" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
