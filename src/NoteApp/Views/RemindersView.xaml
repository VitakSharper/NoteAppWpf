<UserControl x:Class="NoteApp.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:NoteApp.Converters"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,16,16,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                    Command="{Binding LoadCommand}" ToolTip="Refresh">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
            <TextBlock Text="Reminders" Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" />
        </DockPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Margin="8,0,8,8"
                 HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="10,10,0,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12,8" Margin="4,2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" ToolTip="Remove this reminder"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                    Visibility="{Binding CanClear, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Kind="BellOffOutline" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" ToolTip="Open the note"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Kind="OpenInApp" Width="16" Height="16" />
                            </Button>
                            <materialDesign:PackIcon Kind="BellRingOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding When, Mode=OneWay}" />
                                    <Run Text="{Binding Note, Mode=OneWay, StringFormat=' · in {0}', TargetNullValue=''}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Items.Count}" Value="0" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="BellOutline" Width="56" Height="56" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="No reminders" FontSize="16" HorizontalAlignment="Center" Margin="0,8"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Set one with the bell in a note's header, or on a checklist item." />
        </StackPanel>
    </Grid>
</UserControl>
