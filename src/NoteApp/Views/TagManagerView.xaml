<UserControl x:Class="NoteApp.Views.TagManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:NoteApp.Converters"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:TagColorBrushConverter x:Key="TagBrush" />
    </UserControl.Resources>

    <Grid Margin="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Manage Tags"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16" />

        <!-- Create Tag -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16"
                             UniformCornerRadius="12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Add Tag" Command="{Binding CreateTagCommand}" Margin="16,0,0,0" />
                <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="New tag name..."
                         VerticalAlignment="Center" FontSize="14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CreateTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </materialDesign:Card>

        <!-- Loading -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top" />

        <!-- Tags List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,4" Padding="12"
                                             UniformCornerRadius="8"
                                             HorizontalAlignment="Stretch"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <DockPanel>
                                <!-- Actions -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Edit" Width="32" Height="32"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Delete" Width="32" Height="32"
                                            Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" />
                                    </Button>
                                </StackPanel>

                                <!-- The tag as its chip looks everywhere else -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="12" Padding="12,4" BorderThickness="1"
                                        Background="{Binding Color, Converter={StaticResource TagBrush}, ConverterParameter=Background}"
                                        BorderBrush="{Binding Color, Converter={StaticResource TagBrush}, ConverterParameter=Border}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Tag" VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
                                                                 Foreground="{Binding Color, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}" />
                                        <TextBlock Text="{Binding Name.Value}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Color, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Edit Dialog Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.3" />
            </Grid.Background>
            <materialDesign:Card Padding="24" MaxWidth="400"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="Edit Tag" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,16" />
                    <TextBox Text="{Binding EditTagName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tag name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16" MinWidth="280">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Colour" FontSize="13" Margin="0,0,0,8"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <!-- One swatch per palette entry; the picked one gets an accent ring. -->
                    <ItemsControl ItemsSource="{Binding Palette}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Margin="0,0,6,6" Padding="0" Cursor="Hand"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Color}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Ring" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="12" BorderThickness="1"
                                                        Background="{Binding Background}" BorderBrush="{Binding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{x:Static converters:EqualityConverter.Instance}">
                                                            <Binding Path="Color" />
                                                            <Binding Path="DataContext.EditTagColor" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                        <Button Content="Save" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
