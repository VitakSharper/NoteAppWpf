<Window x:Class="NoteApp.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Quick note — NoteApp" Width="520" Height="360" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Style="{StaticResource MaterialDesignWindow}">

    <!-- Ctrl+Alt+N from anywhere: jot, Ctrl+Enter, back to what you were doing. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
        <KeyBinding Gesture="Ctrl+Enter" Command="Save" />
        <KeyBinding Gesture="Ctrl+S" Command="Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCancel" />
        <CommandBinding Command="Save" Executed="OnSave" />
    </Window.CommandBindings>

    <DockPanel Background="{DynamicResource MaterialDesignPaper}" Margin="0">
        <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,14">
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="Save" ToolTip="Save (Ctrl+Enter)" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="Close" ToolTip="Close without saving (Esc)" />
            <TextBlock x:Name="Error" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
            <TextBox x:Name="TitleBox" materialDesign:HintAssist.Hint="Title (optional: the first line otherwise)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
        </StackPanel>
        <TextBox x:Name="BodyBox" Margin="16,0,16,0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 materialDesign:HintAssist.Hint="Write it down…"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
    </DockPanel>
</Window>
