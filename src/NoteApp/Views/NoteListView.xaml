<UserControl x:Class="NoteApp.Views.NoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:NoteApp.Converters"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:NoteTypeToIconConverter x:Key="NoteTypeToIcon" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <SolidColorBrush x:Key="TagBadgeBackground" Color="#C8E6C9" />
        <SolidColorBrush x:Key="TagBadgeForeground" Color="#1B5E20" />
        <SolidColorBrush x:Key="TagBadgeBorder" Color="#81C784" />
        <SolidColorBrush x:Key="TagBadgeSelectedBackground" Color="#2E7D32" />
        <SolidColorBrush x:Key="TagBadgeSelectedForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TagBadgeSelectedBorder" Color="#1B5E20" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <materialDesign:Card Grid.Row="0" Margin="16,16,16,8" Padding="16"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear" Margin="8,0,0,0">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding SearchCommand}" ToolTip="Search">
                    <materialDesign:PackIcon Kind="Magnify" />
                </Button>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search notes..."
                         materialDesign:TextFieldAssist.HasClearButton="False"
                         VerticalAlignment="Center"
                         FontSize="14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </materialDesign:Card>

        <!-- Filters -->
        <DockPanel Grid.Row="1" Margin="16,0,16,8">
            <!-- View toggle + Sort (right side) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"
                          materialDesign:HintAssist.Hint="Sort by"
                          Width="160" FontSize="12" Height="32" Margin="0,0,8,0"
                          materialDesign:ComboBoxAssist.ShowSelectedItem="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                              IsChecked="{Binding IsListView}" ToolTip="Toggle list/card view"
                              Width="32" Height="32">
                    <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" />
                </ToggleButton>
            </StackPanel>

            <!-- Type Filters + Tag Filters (left side) -->
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding TypeFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Margin="0,0,4,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding DataContext.SelectTypeFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="8,4" Height="32" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4" />

                <ToggleButton x:Name="TagFilterToggle"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Height="32" Padding="8,4" Cursor="Hand"
                              ToolTip="Show/hide tag filters">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Tags" FontSize="12" VerticalAlignment="Center" />
                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,0,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ChevronDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TagFilterToggle}" Value="True">
                                            <Setter Property="Kind" Value="ChevronUp" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </DockPanel>

        <!-- Tag Filter Panel (collapsible) -->
        <Border Grid.Row="2" Margin="16,0,16,8"
                Visibility="{Binding IsChecked, ElementName=TagFilterToggle, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding AllTags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="3"
                                Command="{Binding DataContext.ToggleTagFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand" Height="28" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TagBorder"
                                            Background="{StaticResource TagBadgeBackground}"
                                            BorderBrush="{StaticResource TagBadgeBorder}"
                                            BorderThickness="1" CornerRadius="12"
                                            Padding="12,4" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="TagText"
                                                   Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TagBadgeForeground}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TagBorder" Property="Background"
                                                    Value="{StaticResource TagBadgeSelectedBackground}" />
                                            <Setter TargetName="TagBorder" Property="BorderBrush"
                                                    Value="{StaticResource TagBadgeSelectedBorder}" />
                                            <Setter TargetName="TagText" Property="Foreground"
                                                    Value="{StaticResource TagBadgeSelectedForeground}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Loading -->
        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top" />

        <!-- Notes Card View -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsListView, Converter={StaticResource InverseBoolToVis}}">
            <ItemsControl ItemsSource="{Binding Notes}" Margin="16,0,16,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Width="320" Margin="4,4" Padding="0"
                                             materialDesign:ElevationAssist.Elevation="Dp2"
                                             Cursor="Hand">
                            <materialDesign:Card.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </materialDesign:Card.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header with title -->
                                <DockPanel Grid.Row="0" Margin="16,12,16,4">
                                    <materialDesign:PackIcon Width="24" Height="24" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             DockPanel.Dock="Left" Margin="0,0,8,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Note" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                        <Setter Property="Kind" Value="Lock" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding Title.Value}" FontWeight="Medium" FontSize="15"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Block type icons summary -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,4,16,4">
                                    <!-- Encrypted indicator -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="ShieldLock" Width="14" Height="14" Margin="0,0,4,0"
                                                                 Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                        <TextBlock Text="Encrypted" FontSize="11" FontStyle="Italic"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                    </StackPanel>
                                    <!-- Normal block summary (hidden when encrypted) -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="NoteText" Width="16" Height="16" Margin="0,0,4,0"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16" Margin="0,0,4,0"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <materialDesign:PackIcon Kind="Link" Width="16" Height="16" Margin="0,0,4,0"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLinks}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Blocks.Count, StringFormat='{}{0} block(s)'}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tags -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" Margin="12,4,12,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource TagBadgeBackground}"
                                                    BorderBrush="{StaticResource TagBadgeBorder}"
                                                    BorderThickness="1" CornerRadius="10"
                                                    Padding="10,3" Margin="2">
                                                <TextBlock Text="{Binding Name.Value}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TagBadgeForeground}"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Footer: date + actions -->
                                <DockPanel Grid.Row="3" Margin="16,4,8,8">
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}"
                                               FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Edit" Width="28" Height="28"
                                                Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Delete" Width="28" Height="28"
                                                Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                                Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Notes List View -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Notes}" Margin="16,0,16,16"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedNote}"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True" CanUserReorderColumns="False"
                  Background="Transparent" BorderThickness="0"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 4"
                  materialDesign:DataGridAssist.CellPadding="8 6"
                  Cursor="Hand">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding OpenNoteCommand}"
                              CommandParameter="{Binding SelectedNote}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <!-- Icon -->
                <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Note" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                <Setter Property="Kind" Value="Lock" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Title -->
                <DataGridTextColumn Header="Title" Binding="{Binding Title.Value}"
                                    Width="*" SortMemberPath="Title.Value"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                <!-- Blocks -->
                <DataGridTextColumn Header="Blocks" Binding="{Binding Blocks.Count}"
                                    Width="70" CanUserSort="False"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                <!-- Tags -->
                <DataGridTemplateColumn Header="Tags" Width="200" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource TagBadgeBackground}"
                                                BorderBrush="{StaticResource TagBadgeBorder}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="8,2" Margin="2,1">
                                            <TextBlock Text="{Binding Name.Value}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TagBadgeForeground}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Updated -->
                <DataGridTextColumn Header="Updated" Width="150"
                                    Binding="{Binding UpdatedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}"
                                    SortMemberPath="UpdatedAt"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                <!-- Created -->
                <DataGridTextColumn Header="Created" Width="150"
                                    Binding="{Binding CreatedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}"
                                    SortMemberPath="CreatedAt"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                <!-- Actions -->
                <DataGridTemplateColumn Header="" Width="80" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Edit" Width="28" Height="28"
                                        Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Delete" Width="28" Height="28"
                                        Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                        Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="NoteOff" Width="64" Height="64" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="No notes found" FontSize="16" HorizontalAlignment="Center" Margin="0,8"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <Button Content="Create your first note" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding CreateNoteCommand}" Margin="0,8" />
        </StackPanel>
    </Grid>
</UserControl>
