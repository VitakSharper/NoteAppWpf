<UserControl x:Class="NoteApp.Views.NoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:NoteApp.Converters"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="TagBadgeBackground" Color="#E6E8FF" />
        <SolidColorBrush x:Key="TagBadgeForeground" Color="#3A3F8F" />
        <SolidColorBrush x:Key="TagBadgeBorder" Color="#C5CAF5" />
        <SolidColorBrush x:Key="TagBadgeSelectedBackground" Color="#6C79FF" />
        <SolidColorBrush x:Key="TagBadgeSelectedForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TagBadgeSelectedBorder" Color="#6C79FF" />

        <!-- Type filter rendered as MD3 filter chips: the selected one is a filled
             violet pill, the others a quiet outline. Selection drives the filter. -->
        <Style x:Key="FilterChipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="16" Padding="14,6" SnapsToDevicePixels="True"
                                Background="Transparent"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                            <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource TagBadgeSelectedBackground}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource TagBadgeSelectedBorder}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagBadgeSelectedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search: rounded outlined field with the magnifier built in. Enter searches;
             the X resets text, type and tag filters and only shows when there is something to reset. -->
        <DockPanel Grid.Row="0" Margin="16,16,16,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding ClearSearchCommand}" ToolTip="Clear search and filters"
                    Width="36" Height="36" Margin="4,0,0,0"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="20" Height="20" />
            </Button>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search notes (Ctrl+F)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Search notes…"
                     materialDesign:HintAssist.IsFloating="False"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="20"
                     Padding="8,10" FontSize="13" VerticalAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Type filter chips -->
        <ListBox Grid.Row="1" Margin="16,0,16,10"
                 ItemsSource="{Binding TypeFilters}"
                 SelectedItem="{Binding SelectedTypeFilter}"
                 ItemContainerStyle="{StaticResource FilterChipItemStyle}"
                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Tags toggle (left) + Sort (right) -->
        <DockPanel Grid.Row="2" Margin="16,0,16,8">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort}"
                      materialDesign:HintAssist.Hint="Sort by"
                      Width="170" FontSize="12" Height="32" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      materialDesign:ComboBoxAssist.ShowSelectedItem="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ToggleButton x:Name="TagFilterToggle"
                          HorizontalAlignment="Left"
                          Style="{StaticResource MaterialDesignFlatButton}"
                          Height="32" Padding="8,4" Cursor="Hand"
                          ToolTip="Show/hide tag filters">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="Tags" FontSize="12" VerticalAlignment="Center" />
                    <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,0,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="ChevronDown" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TagFilterToggle}" Value="True">
                                        <Setter Property="Kind" Value="ChevronUp" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </StackPanel>
            </ToggleButton>
        </DockPanel>

        <!-- Tag Filter Panel (collapsible) -->
        <Border Grid.Row="3" Margin="16,0,16,8"
                Visibility="{Binding IsChecked, ElementName=TagFilterToggle, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding AllTags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="3"
                                Command="{Binding DataContext.ToggleTagFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand" Height="28" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TagBorder"
                                            Background="{StaticResource TagBadgeBackground}"
                                            BorderBrush="{StaticResource TagBadgeBorder}"
                                            BorderThickness="1" CornerRadius="12"
                                            Padding="12,4" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="TagText"
                                                   Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TagBadgeForeground}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TagBorder" Property="Background"
                                                    Value="{StaticResource TagBadgeSelectedBackground}" />
                                            <Setter TargetName="TagBorder" Property="BorderBrush"
                                                    Value="{StaticResource TagBadgeSelectedBorder}" />
                                            <Setter TargetName="TagText" Property="Foreground"
                                                    Value="{StaticResource TagBadgeSelectedForeground}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Loading -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top" />

        <!-- Comfortable single-column note list -->
        <ListBox Grid.Row="4" ItemsSource="{Binding Notes}" Margin="8,0,8,8"
                 SelectedItem="{Binding SelectedNote}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="14,10" Margin="4,2"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open"
                                          Command="{Binding PlacementTarget.Tag.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="OpenInApp" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete"
                                          Command="{Binding PlacementTarget.Tag.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="DeleteOutline" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title row: icon + title, then type dots and date on the right -->
                            <DockPanel Grid.Row="0">
                                <materialDesign:PackIcon Width="18" Height="18" DockPanel.Dock="Left"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="Note" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                    <Setter Property="Kind" Value="Lock" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>

                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding UpdatedAt, StringFormat='{}{0:MMM dd}'}"
                                           FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialDesign:PackIcon Kind="NoteText" Width="13" Height="13" Margin="3,0,0,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />
                                    <materialDesign:PackIcon Kind="FileDocument" Width="13" Height="13" Margin="3,0,0,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
                                    <materialDesign:PackIcon Kind="Link" Width="13" Height="13" Margin="3,0,0,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock Text="{Binding Title.Value}" FontWeight="Medium" FontSize="14"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Preview snippet (hidden when there is none, e.g. encrypted notes) -->
                            <TextBlock Grid.Row="1" Margin="26,3,0,0"
                                       Text="{Binding Preview}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="18"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Tags (row disappears when the note has none) -->
                            <ItemsControl Grid.Row="2" Margin="26,6,0,0" ItemsSource="{Binding Tags}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource TagBadgeBackground}"
                                                BorderBrush="{StaticResource TagBadgeBorder}"
                                                BorderThickness="1" CornerRadius="9"
                                                Padding="8,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Name.Value}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TagBadgeForeground}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state: shown once the load finished and came back empty.
             Visibility lives in the style only — a local binding would win over
             the trigger (and the old one was tied to IsLoading, not to Count). -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Notes.Count}" Value="0" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="NoteOff" Width="64" Height="64" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="No notes found" FontSize="16" HorizontalAlignment="Center" Margin="0,8"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <Button Content="Create your first note" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding CreateNoteCommand}" Margin="0,8" />
        </StackPanel>
    </Grid>
</UserControl>
