<Window x:Class="NoteApp.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding ElementName=TitleText, Path=Text}"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">

    <Border CornerRadius="{StaticResource CardCornerRadius}"
            Background="{DynamicResource MaterialDesignCardBackground}"
            Padding="0">
    <StackPanel Margin="24" Width="360">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Lock" Width="28" Height="28"
                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock x:Name="TitleText" Text="Enter Password"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="PromptText" Text="Enter the password to unlock this note."
                   TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />

        <PasswordBox x:Name="PasswordBox"
                     materialDesign:HintAssist.Hint="Password"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     Margin="0,0,0,8" />

        <PasswordBox x:Name="ConfirmPasswordBox"
                     materialDesign:HintAssist.Hint="Confirm password"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
