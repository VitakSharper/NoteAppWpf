<Window x:Class="NoteApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="NoteApp Help"
        Width="660" Height="740" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource MaterialDesignWindow}">

    <!-- Non-modal on purpose: the window can stay open beside the app while a shortcut
         is tried out. Escape closes it; F1 in the main window brings it back to the front. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnClose" />
    </Window.CommandBindings>

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
            <Setter Property="Margin" Value="0,22,0,8" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignChipBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource MaterialDesignPaper}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="28,22,28,16"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
            <DockPanel>
                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="30" Height="30"
                                         VerticalAlignment="Center" Margin="0,0,14,0"
                                         Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                <TextBlock Text="NoteApp" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="28,12"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
            <Button Content="Close" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="Close" ToolTip="Close (Esc)" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,28,20">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Section}" Text="Getting started" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Your notes are listed in the middle pane. Click one to open it on the right, or press Ctrl+N to start a new one. Ctrl+K opens the quick switcher: a few letters of a title are enough to get to any note, and the same box runs commands. Alt+Left and Alt+Right go back and forward through the notes you have opened." />
                <TextBlock Style="{StaticResource Body}"
                           Text="A note is a title followed by ordered blocks: text, file, link or checklist. Add blocks with the buttons under the title, and reorder them by dragging the grip at the left of a block's header, or with its arrows. Files dropped from Explorer onto an open note become file blocks. A note needs at least one block." />
                <TextBlock Style="{StaticResource Body}"
                           Text="The line under the editor counts the note's words as you type, says when it was last saved, and shows Unsaved changes as long as there are some. Save with Ctrl+S or the Save button. If you leave a note with unsaved changes (by opening another one, pressing Escape or closing the app) NoteApp asks whether to save, discard or stay. While a note has unsaved changes NoteApp also keeps a draft of it every 20 seconds (never for an encrypted note); if it ever closes without saving, the next start offers to restore that draft." />

                <TextBlock Style="{StaticResource Section}" Text="Keyboard shortcuts" />
                <ItemsControl x:Name="ShortcutsList" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Keycap}">
                                    <TextBlock Style="{StaticResource KeyText}" Text="{Binding Keys}" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Margin="0"
                                           Text="{Binding Description}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Section}" Text="Notes and blocks" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Text blocks are rich text: bold, italic, underline, strikethrough, the highlighter, inline code, three sizes of heading, bullet and numbered lists from the toolbar, images pasted from the clipboard or inserted from a file. Markdown's line starters work too: type #, ## or ### and a space at the start of a line for a heading, - for bullets, 1. for numbering, or [] to turn the line into a checklist block (Ctrl+Z gives the typed characters back); Enter after a heading goes back to body text. Each text block has its own find bar (the magnifier, or Ctrl+F while typing in it). A web address (http://, https:// or www.) turns into a link once you type a space or a new line after it; click it to open it, or Alt+Click to put the cursor in it." />
                <TextBlock Style="{StaticResource Body}"
                           Text="File blocks keep the file itself inside the database; Save file to disk writes it back out. Link blocks hold a checked URL and a description; the button next to the URL opens it." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Checklist blocks hold tickable items: press Enter in an item to add the next one, tick one to strike it through, and the block counts what is done. Alt+Up / Alt+Down move an item; Hide done tucks the ticked items away for as long as the note is open. Empty items are dropped when the note is saved, and the item texts are searchable like any other text. An item that holds a web address gets an open button, and an item that is nothing but an address reads as a link." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Type [[ in a text block to link to another note: a list of your notes opens at the cursor, typing narrows it by title, Enter (or a click) puts the link in. Clicking the link opens that note (asking to save this one first if needed), and a note that others link to lists them under its title as Linked from. The link keeps the title the note had when you linked it. Links written inside encrypted notes work, but encrypted notes do not appear under Linked from." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Code blocks keep text exactly as you type it, in a monospace font: commands, queries, configuration. Tab inserts a tab, nothing wraps or turns into a link, and the copy button in the corner copies the whole block. Their text is searchable like any other." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Secret blocks hold a login: what it is for, the user name, the password and, if you like, the address it is used at. The password stays masked until you click the eye. The copy buttons put the user name or the password on the clipboard without it going into the clipboard history (Win+V) or the cloud clipboard, and NoteApp wipes it again after 30 seconds unless you have copied something else since. The password is never searched, shown in the list, exported or written to a draft. Keep such notes encrypted: in a note that is not, the block reminds you that its password is stored as plain text." />
                <TextBlock Style="{StaticResource Body}"
                           Text="The PDF, Word and Markdown buttons in the editor header export the whole open note (Markdown puts the images in a folder next to the .md file): text with its formatting and images, checklists as ticked boxes, links — clickable in both, including the addresses in text and checklist items — and the attached files listed by name — their bytes stay in the database." />

                <TextBlock Style="{StaticResource Body}"
                           Text="The ⋮ button in the editor header holds Save as template and Duplicate. Save as template keeps what the note holds right now, saved or not, as a template of the same name (an older one of that name is replaced); the template button in the rail, under +, starts a new note from any template and can delete one. Templates are not notes: they never show in the list, a search or a link. Duplicate (also on a right-click in the list) makes a copy titled with (copy), encrypted with the same password if the original is, and opens it." />

                <TextBlock Style="{StaticResource Body}"
                           Text="Each save keeps the state it replaces as a version — the last ten by default (Settings › Versions kept of each note). ⋮ › Version history lists them with their date; pick one to read it, and Restore this version puts it in the editor: nothing changes until you save, and saving keeps the state you replaced as a version too. Attached files are kept in every version, so the database grows with them. The versions of an encrypted note are stored encrypted and open with its password (one saved under an older password says so)." />

                <TextBlock Style="{StaticResource Section}" Text="Search, tags and filters" />
                <TextBlock Style="{StaticResource Body}"
                           Text="The search box matches titles, text, checklist items, code, link descriptions, file names and the label, user name and address of secrets; press Enter to run it. Every word has to match; put a phrase in double quotes to find it as it is, and narrow the search with tag:work (tag:&quot;two words&quot;), has:file, has:link, has:checklist, has:code, has:secret, is:pinned or is:encrypted. The words found are highlighted in the list, and a preview that would not show them starts next to them instead. Opening a note from a search opens the find bar of its first text block that contains the term, with the matches highlighted. Narrow the list with the All / Text / File / Link / Tasks chips and with tags under Tags; the sort menu orders by date — with headings such as Today, Yesterday or the month — or by title. Right-click a note to pin it: pinned notes stay at the top whatever the sort. The filter icon next to the search box clears everything at once." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Tags are created inline from the editor, and renamed, coloured or deleted from the Tags page in the rail (the pencil opens Edit Tag, with its colour)." />

                <TextBlock Style="{StaticResource Body}"
                           Text="Right-click › Archive keeps a note out of the list without deleting it — for finished projects, old trips. The archive toggle next to the sort menu shows the archived notes, with the same search and filters; they open and save as usual, and right-click › Unarchive brings one back. A link to an archived note keeps working." />

                <TextBlock Style="{StaticResource Section}" Text="Trash" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Delete a note with the trash button in the editor header, or by right-clicking it in the list. It moves to the trash, and the UNDO button in the message that follows puts it straight back. Open the trash with the bin toggle next to the sort menu: notes there can be restored or deleted forever (right-click), and Empty trash clears all of it." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Only the permanent gestures ask for confirmation, and Settings lets you switch that confirmation off." />

                <TextBlock Style="{StaticResource Section}" Text="Encrypted notes" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Switch encryption on in the editor and choose a password: the blocks of the note are stored encrypted (AES-GCM, key derived with PBKDF2). In the list the note shows a lock and no preview, and its content is not searchable." />
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                           Text="The password is asked every time the note is opened and is stored nowhere. A forgotten password means the content cannot be recovered." />
                <TextBlock Style="{StaticResource Body}"
                           Text="An open encrypted note also closes itself after a while without a keystroke or a click — five minutes by default, changeable in Settings (Never turns it off) — and at once when Windows locks (Win+L), the remote session disconnects or the computer goes to sleep. Unsaved changes are saved first, so nothing is lost, and the password is forgotten: reopening the note asks for it again. It keeps a decrypted note off an unattended screen; it is not protection against someone inspecting the computer's memory." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Text copied (Ctrl+C) out of an encrypted note is kept out of the clipboard history and the cloud clipboard, and wiped after 30 seconds — as are the user names and passwords copied from a secret block. Closing NoteApp wipes it too." />

                <TextBlock Style="{StaticResource Section}" Text="Backup" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Settings > Backup Now exports the whole database as a BACPAC and packs it into a password-protected AES-256 zip in the backup folder you chose. The backup password is kept encrypted for your Windows account. Automatic backup (Daily or Weekly) runs the same export on its own: NoteApp checks when it starts and every hour, counts backups taken by hand, and keeps only the number of backups you chose — it never deletes a folder that is not one of its own backups." />
                <TextBlock Style="{StaticResource Body}"
                           Text="Restoring is manual for now: unzip the archive, then import the .bacpac with SqlPackage or SQL Server Management Studio." />

                <TextBlock Style="{StaticResource Section}" Text="Where things live" />
                <TextBlock Style="{StaticResource Body}" Text="Settings (settings.json) and the crash log (crash.log) are in:" />
                <TextBlock x:Name="DataFolderText" Style="{StaticResource Body}" FontFamily="Consolas" />
                <TextBlock Style="{StaticResource Body}"
                           Text="The database connection string is read from .NET user secrets (ConnectionStrings:NoteDb), or from an appsettings.json placed next to the executable." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
