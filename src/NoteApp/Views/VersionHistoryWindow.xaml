<Window x:Class="NoteApp.Views.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Version history" Width="860" Height="580" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnClose" />
    </Window.CommandBindings>

    <DockPanel Background="{DynamicResource MaterialDesignPaper}">
        <Border DockPanel.Dock="Bottom" Padding="20,12"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="Close" Margin="8,0,0,0" />
                <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore this version"
                        Style="{StaticResource MaterialDesignRaisedButton}" IsEnabled="False" Click="OnRestore"
                        ToolTip="Put this version in the editor — saving it keeps the current state as a version too" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="Each save keeps what it replaces. A restored version is only in the editor until you save it." />
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Saved versions" Margin="4,0,0,8"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                <TextBlock x:Name="NoVersions" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,0,0,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="No earlier version yet: one is kept each time the note is saved (Settings › Versions kept)." />
                <ListBox x:Name="Versions" SelectionChanged="OnVersionSelected" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Padding="16,12" CornerRadius="{StaticResource CardCornerRadius}"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                <DockPanel>
                    <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    <TextBlock x:Name="PreviewError" DockPanel.Dock="Top" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PreviewLines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="13" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
