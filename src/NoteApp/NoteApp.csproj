<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the notification-area icon only (System.Windows.Forms.NotifyIcon); its namespaces are
         kept out of the implicit usings below, or every WPF Application, MessageBox, Button…
         would become ambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UserSecretsId>8573b412-7954-40ff-8f8d-03c5018d4cd3</UserSecretsId>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- The release workflow sets it from the tag (v1.2.0 -> 1.2.0); the update check compares
         the latest GitHub Release with it. -->
    <Version>1.1.0</Version>
    <!-- DacFx (BACPAC export) calls FileVersionInfo.GetVersionInfo(Assembly.Location),
         and Location is "" inside a single-file bundle, so "Backup Now" fails with
         ArgumentException "The path is empty. (Parameter 'path')" for every destination.
         Self-extracting the whole payload gives those assemblies a real path on disk.
         Non-single-file builds ignore it, so it is safe to set unconditionally. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Single-file publish only: the exe shrinks from ~275 MB to ~95 MB, and since everything
         is extracted to %TEMP% on first start anyway (above), later starts are unaffected.
         Checked 2026-09-24: first start 4.2 s (was 11 s), then 1.2 s; the DacFx backup still works. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.3.93" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
